{
  "name": "story-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive branching stories powered by Yarn Spinner, with images and music.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run dialogue:check && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dialogue:check": "node scripts/check-dialogue.ts",
    "images": "node scripts/optimize-images.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yarnspinner-typescript": "1.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
